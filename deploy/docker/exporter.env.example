# Copy to exporter.env and fill in. Never commit exporter.env.
ATSCALE_INSTANCES=prod=https://atscale.example.com
ATSCALE_TOKEN_PROD=replace-with-api-token
POLL_SECONDS=120
# https:// only. For http:// (AtScale sml-api inside the same cluster) also set ALLOW_INSECURE_HTTP=true
# and API_PREFIX=/v1/public.
# Uncomment if AtScale uses a private or self-signed certificate (mount the file, see README):
# CA_BUNDLE=/etc/atscale-ca/ca.crt
